# Site URL (used for SEO canonical URLs, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://www.devopslife.space

# Editor origin. Use your production domain on Vercel.
# For local development, use http://localhost:3000 with a separate OAuth app.
NEXTAUTH_URL=https://www.devopslife.space

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# GitHub OAuth app: callback is <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Immutable numeric GitHub account ID, not a username.
BLOG_ADMIN_GITHUB_ID=

# A separate PRIVATE repository, initialized with a main branch.
BLOG_GITHUB_REPO=
BLOG_GITHUB_BRANCH=main

# Fine-grained token: only the content repository, Contents read/write.
BLOG_GITHUB_TOKEN=
